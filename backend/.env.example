# Copie para backend/.env. O arquivo real nunca vai para o Git.

ENVIRONMENT=dev
DATABASE_URL=postgresql+psycopg://grudado:grudado@localhost:5432/grudado_tasks

# Em producao e obrigatorio trocar. Gerar com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=dev-secret-nao-use-em-producao

# dev   -> entra como qualquer e-mail, sem verificar nada (recusado em producao)
# google -> OAuth2/OIDC real
AUTH_PROVIDER=dev

# Obrigatorios quando AUTH_PROVIDER=google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback

# Dominio do Google Workspace aceito. Validado no servidor a cada login:
# e a barreira que impede conta Google de fora da empresa de entrar.
ALLOWED_HOSTED_DOMAIN=grudadoemvoce.com.br

FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173"]
