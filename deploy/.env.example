# Copie para deploy/.env no VPS. Nunca versionar o arquivo real.

DOMINIO=tasks.grudadoemvoce.com.br

POSTGRES_USER=grudado
POSTGRES_PASSWORD=
POSTGRES_DB=grudado_tasks

# python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Credenciais do OAuth client criado no Google Cloud Console.
# A redirect URI cadastrada la precisa ser exatamente:
#   https://<DOMINIO>/api/v1/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

ALLOWED_HOSTED_DOMAIN=grudadoemvoce.com.br
